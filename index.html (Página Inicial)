style.css
body.landing {
    margin: 0;
    padding: 0;
    font-family: Arial;
    height: 100vh;
    overflow: hidden;
}

.banner-container {
    background: url("https://i.pinimg.com/736x/2b/7a/70/2b7a70b059fc4cc330a1df9605670d79.jpg") center/cover no-repeat;
    width: 100%;
    height: 100vh;
    position: relative;
}

.overlay {
    background: rgba(255, 182, 185, 0.35);
    width: 100%;
    height: 100%;
    position: absolute;
}

.content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: white;
}

.content h1 {
    font-size: 50px;
    font-weight: bold;
    text-shadow: 0 0 10px #ff8fa3;
}

.content p {
    font-size: 20px;
    margin-bottom: 30px;
}

/* BOTÕES */
.btn {
    padding: 12px 25px;
    margin: 10px;
    border-radius: 12px;
    font-size: 18px;
    font-weight: bold;
    text-decoration: none;
}

.btn.rosa {
    background-color: #ff8fa3;
    color: white;
}

.btn.branco {
    background-color: white;
    color: #ff8fa3;
}
